{{- $role := get . "role" | default "workstation" -}}
onboarding = false
{{ if eq $role "bb-worker" }}
[worktrees]
directory = "~/code/herdr-worktrees"
{{ end }}
# herdr configuration — https://herdr.dev/docs/configuration/
# Reload with: herdr server reload-config

[theme]
# Inherit the terminal's Tokyo Night Dark palette.
name = "terminal"

[theme.custom]
# Blend the main chrome into the terminal background, then build hierarchy with
# Tokyo Night Dark surface and overlay tokens.
panel_bg = "reset"
surface0 = "#24283B"
surface1 = "#292E42"
surface_dim = "#16161E"
overlay0 = "#414868"
overlay1 = "#565F89"
text = "#C0CAF5"
subtext0 = "#A9B1D6"
accent = "#7AA2F7"
red = "#F7768E"
green = "#9ECE6A"
yellow = "#E0AF68"
blue = "#7DCFFF"

[ui]
# Keep the active accent on borders/highlights explicit (same as theme.custom.accent).
accent = "#7AA2F7"
# Make split panes and chrome edges a bit more intentional.
pane_borders = true
pane_gaps = true

# Show the zoom indicator and server hostname at the top-right of the tab bar.
tab_bar_right = [{ type = "zoom" }, { type = "hostname" }]

# Show the server hostname and current workspace in the outer terminal title.
window_title = "{hostname}: {workspace}"

# Space entries: bold name, dim branch, and a blank row between each space.
[ui.sidebar.spaces]
row_gap = 1
rows = [
  ["state_icon", { token = "workspace", bold = true }],
  [{ token = "branch", dim = true, fg = "#565F89" }, "git_status"],
]

# Agent entries: same spacing so the lower panel doesn't look like loose text.
[ui.sidebar.agents]
row_gap = 1
rows = [
  ["state_icon", { token = "workspace", bold = true }, "tab"],
  [{ token = "agent", dim = true, fg = "#565F89" }],
]

# NOTE: this table must stay above the [[keys.command]] blocks below. In TOML,
# bare keys after an array-of-tables land inside that table, and herdr rejects
# them as unknown keys.
[keys]
prefix = "ctrl+space"
detach = "prefix+d"
zoom = "prefix+z"

# Match the workstation's directional pane navigation.
focus_pane_left = "ctrl+alt+left"
focus_pane_down = "ctrl+alt+down"
focus_pane_up = "ctrl+alt+up"
focus_pane_right = "ctrl+alt+right"

resize_mode = ["prefix+ctrl+left", "prefix+ctrl+down", "prefix+ctrl+up", "prefix+ctrl+right"]
resize_pane_left = "ctrl+alt+shift+left"
resize_pane_down = "ctrl+alt+shift+down"
resize_pane_up = "ctrl+alt+shift+up"
resize_pane_right = "ctrl+alt+shift+right"

# Match Omarchy's tab and workspace navigation.
previous_tab = ["prefix+p", "alt+left"]
next_tab = ["prefix+n", "alt+right"]
move_tab_previous = "alt+shift+left"
move_tab_next = "alt+shift+right"
previous_workspace = "alt+up"
next_workspace = "alt+down"
new_workspace = ["prefix+shift+n", "prefix+shift+c"]

rename_tab = "prefix+r"
rename_workspace = "prefix+shift+r"
# Free Shift+R for workspace renaming, matching Omarchy.
reload_config = "prefix+q"

# Focus agent rows 1-9 directly. Default is alt+1..9, which macOS eats for
# Spaces before the terminal ever sees it.
focus_agent = "ctrl+1..9"

switch_workspace = "prefix+shift+1..9"
# lazygit popup, same binding and size as tmux (bind g)
[[keys.command]]
key = "prefix+shift+g"
type = "popup"
command = "lazygit"
description = "run lazygit"
width = "80%"
height = "80%"

# lazygit popup, same binding and size as tmux (bind g)
[[keys.command]]
key = "prefix+shift+h"
type = "popup"
command = "hunk diff"
description = "run hunk"
width = "80%"
height = "80%"

# yazi popup, same binding and size as tmux (bind F)
[[keys.command]]
key = "prefix+shift+f"
type = "popup"
command = "yazi"
description = "run yazi"
width = "80%"
height = "80%"

[[keys.command]]
key = "prefix+t"
type = "popup"
command = "exec \"${SHELL:-sh}\""
description = "open scratch terminal"
width = "80%"
height = "80%"

[[keys.command]]
key = "prefix+a"
type = "plugin_action"
command = "annotate.capture"
description = "annotate text"

[[keys.command]]
key = "prefix+shift+a"
type = "plugin_action"
command = "annotate.copy-context"
description = "copy annotations as context"

[[keys.command]]
key = "prefix+ctrl+a"
type = "plugin_action"
command = "annotate.copy-archive"
description = "copy annotations as context and archive them"

[[keys.command]]
key = "prefix+m"
type = "plugin_action"
command = "annotate.manage"
description = "manage annotations"

# Document review (plannotator-tui)
[[keys.command]]
key = "prefix+o"
type = "plugin_action"
command = "annotate.open"
description = "review documents in this folder"

[[keys.command]]
key = "prefix+shift+o"
type = "plugin_action"
command = "annotate.last"
description = "review the agent's last reply"
[experimental]
kitty_graphics = true
