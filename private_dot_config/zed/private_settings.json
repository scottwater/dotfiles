// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "session": {
    "trust_all_worktrees": true
  },
  "default_open_behavior": "new_window",
  "cli_default_open_behavior": "new_window",
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "terminal": {
    "font_size": 20.0,
  },
  "colorize_brackets": true,
  "sticky_scroll": {
    "enabled": true,
  },
  "git": {
    "hunk_style": "staged_hollow",
  },
  "collaboration_panel": {
    "dock": "left",
    "button": false,
  },
  "outline_panel": {
    "button": false,
    "dock": "right",
  },
  "git_panel": {
    "dock": "left",
    "button": true,
    "collapse_untracked_diff": true,
    "scrollbar": {
      "show": "never",
    },
  },
  "scrollbar": {
    "show": "never",
  },
  "icon_theme": "Bearded Icon Theme",
  "project_panel": {
    "sort_mode": "mixed",
    "default_width": 200.0,
    "starts_open": true,
    "git_status": true,
    "hide_hidden": false,
    "hide_root": true,
    "entry_spacing": "standard",
    "dock": "left",
    "folder_icons": false,
    "auto_fold_dirs": true,
    "auto_reveal_entries": true,
    "scrollbar": {
      "show": "never",
    },
  },
  "ui_font_size": 18.0,
  "ui_font_family": "Hack Nerd Font Mono",
  "buffer_font_family": "Hack Nerd Font Mono",
  "buffer_font_size": 20,
  "theme": "Tokyo Night",
  "languages": {
    "Ruby": {
      "language_servers": ["ruby-lsp"],
    },
  },
  "lsp": {
    "rubocop": {
      "initialization_options": {
        "safeAutocorrect": false,
      },
    },
  },
  "theme_overrides": {
    "Tokyo Night": {
      "terminal.background": "#1a1b26",
      "terminal.foreground": "#c0caf5",
      "terminal.bright_foreground": "#c0caf5",
      "terminal.dim_foreground": "#a9b1d6",
      "terminal.ansi.black": "#15161e",
      "terminal.ansi.bright_black": "#414868",
      "terminal.ansi.red": "#f7768e",
      "terminal.ansi.bright_red": "#ff899d",
      "terminal.ansi.green": "#9ece6a",
      "terminal.ansi.bright_green": "#9fe044",
      "terminal.ansi.yellow": "#e0af68",
      "terminal.ansi.bright_yellow": "#faba4a",
      "terminal.ansi.blue": "#7aa2f7",
      "terminal.ansi.bright_blue": "#8db0ff",
      "terminal.ansi.magenta": "#bb9af7",
      "terminal.ansi.bright_magenta": "#c7a9ff",
      "terminal.ansi.cyan": "#7dcfff",
      "terminal.ansi.bright_cyan": "#a4daff",
      "terminal.ansi.white": "#a9b1d6",
      "terminal.ansi.bright_white": "#c0caf5",
    },
  },
  "file_scan_exclusions": [".worktrees/", "*.log", ".conductor/", ".branches/"],
}
