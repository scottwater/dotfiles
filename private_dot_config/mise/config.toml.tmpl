[tools]
fnox = "latest"
herdr = "latest"
"vfox:mise-plugins/vfox-1password" = "latest"

# Runtimes
node = "24"
ruby = "4.0.6"
"npm:yarn" = "1.22.22"
bun = "latest"
go = "latest"
{{ if eq .chezmoi.os "darwin" -}}
tuist = "4.195.6"
{{ end -}}

# Terminal development tools
age = "latest"
bat = "latest"
delta = "latest"
gh = "latest"
git-filter-repo = "latest"
glow = "latest"
lazygit = "latest"
neovim = "latest"
overmind = "latest"
ripgrep = "latest"
yazi = "latest"
zoxide = "latest"
hunk = "latest"

# Services and deployment helpers
flyctl = "latest"
"pipx:dslr" = { version = "latest", uvx_args = "--with psycopg2-binary" }
"github:axllent/mailpit" = "latest"

[settings]
idiomatic_version_file_enable_tools = ["ruby"]
activate_aggressive = true

[settings.ruby]
compile = false
