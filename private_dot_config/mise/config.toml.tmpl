{{- $role := get . "role" | default "workstation" -}}
[tools]
# Runtimes shared by workstations and disposable development workers.
fnox = "latest"
herdr = "latest"
node = "24.19.0"
ruby = "4.0.6"

{{ if ne $role "bb-worker" -}}
# Workstation-only runtimes.
bun = "latest"
go = "latest"
{{ if eq .chezmoi.os "darwin" -}}
tuist = "4.195.6"
{{ end -}}
{{ end -}}

# Terminal development tools shared by workstations and BB workers.
age = "latest"
bat = "latest"
delta = "latest"
gh = "latest"
git-filter-repo = "latest"
glow = "latest"
lazygit = "latest"
neovim = "latest"
overmind = "latest"
ripgrep = "latest"
yazi = "latest"
zoxide = "latest"
hunk = "latest"

{{ if ne $role "bb-worker" -}}
# Workstation-only services and deployment helpers.
flyctl = "latest"
"pipx:dslr" = { version = "latest", uvx_args = "--with psycopg2-binary" }
"ubi:axllent/mailpit" = "latest"
{{ end -}}

[settings]
idiomatic_version_file_enable_tools = ["ruby"]

[settings.ruby]
compile = false
