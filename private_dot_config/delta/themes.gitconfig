# Tokyo Night Dark (night variant), based on folke/tokyonight.nvim extras.
[delta "tokyonight-night"]
    dark = true
    navigate = true
    side-by-side = true
    syntax-theme = ansi
    # File styling
    file-style = "#7AA2F7" bold
    file-decoration-style = "#565F89" ul
    file-added-label = [+]
    file-copied-label = [==]
    file-modified-label = [*]
    file-removed-label = [-]
    file-renamed-label = [->]
    # Commit styling
    commit-decoration-style = "#7AA2F7" box
    commit-style = "#C0CAF5" bold
    # Hunk headers
    hunk-header-decoration-style = "#414868" box ul
    hunk-header-file-style = "#7DCFFF" bold
    hunk-header-line-number-style = "#FF9E64" bold
    hunk-header-style = file line-number syntax bold
    # Line numbers
    line-numbers = true
    line-numbers-left-format = " {nm:>3} │"
    line-numbers-right-format = " {np:>3} │"
    line-numbers-left-style = "#565F89"
    line-numbers-right-style = "#565F89"
    line-numbers-minus-style = "#914C54" bold
    line-numbers-plus-style = "#449DAB" bold
    line-numbers-zero-style = "#3B4261"
    # Diff content styling
    minus-style = syntax "#4A272F"
    minus-emph-style = syntax "#713137" bold
    minus-non-emph-style = syntax "#4A272F"
    minus-empty-line-marker-style = syntax "#4A272F"
    plus-style = syntax "#243E4A"
    plus-emph-style = syntax "#2C5A66" bold
    plus-non-emph-style = syntax "#243E4A"
    plus-empty-line-marker-style = syntax "#243E4A"
    zero-style = syntax
    # Whitespace errors
    whitespace-error-style = "#F7768E" reverse
    # Blame
    blame-code-style = syntax
    blame-format = "{author:<18} ({commit:>8}) {timestamp:<15}"
    blame-palette = "#16161E" "#1A1B26" "#24283B" "#292E42"
    # Merge conflicts
    merge-conflict-begin-symbol = ⌃
    merge-conflict-end-symbol = ⌄
    merge-conflict-ours-diff-header-style = "#E0AF68" bold
    merge-conflict-theirs-diff-header-style = "#FF9E64" bold
    merge-conflict-ours-diff-header-decoration-style = "#414868" box
    merge-conflict-theirs-diff-header-decoration-style = "#414868" box
