if [ -z "${ZSH_VERSION:-}" ]; then
  if [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv bash)"
  elif [ -x /usr/local/bin/brew ]; then
    eval "$(/usr/local/bin/brew shellenv bash)"
  fi
  return 0 2>/dev/null || exit 0
fi

export PATH="$HOME/.local/bin:$PATH"
if [ -f "$HOME/.atuin/bin/env" ]; then
  . "$HOME/.atuin/bin/env"
fi

{{- if eq .chezmoi.os "linux" }}
# Set UTF-8 locale for proper character rendering (Linux only)
export LANG=C.UTF-8
export LC_ALL=C.UTF-8
{{- end }}

if command -v atuin >/dev/null 2>&1; then
  eval "$(atuin init zsh)"
fi

if command -v stooges >/dev/null 2>&1; then
  eval "$(stooges shell-init zsh)"
fi

if command -v mise >/dev/null 2>&1 && [[ ":$PATH:" != *":$HOME/.local/share/mise/shims:"* ]]; then
  if [[ "$TERM_PROGRAM" == "vscode" ]]; then
    eval "$(mise activate zsh --shims)"
  else
    eval "$(mise activate zsh)"
  fi
fi
if command -v fnox >/dev/null 2>&1; then
  eval "$(fnox activate zsh)"
fi

# Pure prompt
fpath+=($HOME/.zsh/pure)
autoload -U promptinit; promptinit
prompt pure

# Tokyo Night Dark muted foreground for type-ahead suggestions.
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=#565F89'

source "$HOME/.zsh/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
source "$HOME/.zsh/zsh-autosuggestions/zsh-autosuggestions.zsh"

source $HOME/zsh/zsh-z.plugin.zsh
autoload -U compinit; compinit
zstyle ':completion:*' menu select
# Tokyo Night Dark completion colors.
# ow/tw/st cover world-writable dirs (stooges/herdr worktrees are mode 777);
# without them zsh falls back to the unreadable GNU default blue-on-green.
zstyle ':completion:*' list-colors \
  'no=38;2;192;202;245' \
  'fi=38;2;192;202;245' \
  'di=38;2;122;162;247' \
  'ow=38;2;122;162;247' \
  'tw=38;2;122;162;247' \
  'st=38;2;122;162;247' \
  'ln=38;2;187;154;247' \
  'ex=38;2;158;206;106' \
  'ma=48;2;40;52;87;38;2;192;202;245'
zstyle ':completion:*:descriptions' format '%F{#7AA2F7}%d%f'
zstyle ':completion:*:messages' format '%F{#565F89}%d%f'
zstyle ':completion:*:warnings' format '%F{#F7768E}No matches for: %d%f'

export EDITOR=nvim
set -o emacs

source "$HOME/zsh/aliases.zsh"
source "$HOME/zsh/agents.zsh"

# PI
export PI_SUBAGENT_RUNTIME_ROOT="$HOME/.pi/agent/git/github.com/nicobailon/pi-subagents"

# dcg: warn if hook was silently removed from Claude Code settings
if command -v dcg &>/dev/null && command -v jq &>/dev/null; then
  if [ -f "$HOME/.claude/settings.json" ] && \
     ! jq -e '.hooks.PreToolUse[]? | select(.hooks[]?.command | test("dcg$"))' \
       "$HOME/.claude/settings.json" &>/dev/null; then
    printf '\033[1;33m[dcg] Hook missing from ~/.claude/settings.json — run: dcg install\033[0m\n'
  fi
fi

# Mur Pretty Delta
export DELTA_FEATURES="diff-so-fancy tokyonight-night"

# Source local overrides if present
[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"

export HOMEBREW_NO_AUTO_UPDATE=1
