# Coding agent shortcuts

# Claude
alias fable='claude --model fable'
alias opus='claude --model opus'
alias sonet='claude --model sonet'
alias haiku='claude --model haiku'

# Codex (via pi)
alias sol='pi --model "openai-codex/gpt-5.6-sol" --thinking high'
alias terra='pi --model "openai-codex/gpt-5.6-terra" --thinking medium'
alias luna='pi --model "openai-codex/gpt-5.6-luna" --thinking medium'

# Custom (via pi)
alias glm='pi --model "opencode-go/glm-5.2"'
alias minimax='pi --model "opencode-go/minimax-m3"'
alias kimi='pi --model "opencode-go/kimi-k3"'
alias grok='pi --model "grok-cli/grok-4.5" --thinking high'
