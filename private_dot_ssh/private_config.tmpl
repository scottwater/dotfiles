# Keys are served from disk (~/.ssh) via the default macOS ssh-agent.
# 1Password holds copies of the keys as a backup only — copy them down
# manually if a key is ever missing on a new machine.
{{- if eq .chezmoi.os "darwin" }}
Include ~/.orbstack/ssh/config

Host *.ts.net
  ForwardAgent yes

Host *exe.xyz
  ForwardAgent yes

Host *
  AddKeysToAgent yes
  UseKeychain yes
  IdentityFile ~/.ssh/id_ed25519
{{- end }}
