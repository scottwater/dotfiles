#!/usr/bin/env bash
set -u

run_update() {
  local tool_name="$1"
  shift

  echo ""
  echo "=== Updating ${tool_name} ==="

  if "$@"; then
    echo "✅ ${tool_name} updated"
    return 0
  else
    local status=$?
    echo "❌ ${tool_name} update failed (exit ${status})"
    return "$status"
  fi
}

CHEZMOI_ROLE="workstation"
if command -v chezmoi >/dev/null 2>&1; then
  CHEZMOI_ROLE="$(chezmoi execute-template '{{ get . "role" | default "workstation" }}')" || exit 1
fi

failures=0

if [ "$CHEZMOI_ROLE" = "bb-worker" ]; then
  TOOLING_BIN="$HOME/.local/share/orbi/tooling-node/bin"
  npm_command=(env "PATH=$TOOLING_BIN:$PATH" "$TOOLING_BIN/node" "$TOOLING_BIN/npm" --prefix "$HOME/.local/share/orbi/agents")
  run_update "pi runtime" "${npm_command[@]}" install -g --ignore-scripts --min-release-age=0 @earendil-works/pi-coding-agent || failures=$((failures + 1))
  run_update "pi" env "PATH=$TOOLING_BIN:$PATH" "$HOME/.local/bin/pi" update --all || failures=$((failures + 1))
  run_update "codex" "${npm_command[@]}" install -g @openai/codex || failures=$((failures + 1))
else
  run_update "pi" pi update --all || failures=$((failures + 1))
  run_update "codex" npm --prefix "$HOME/.local" install -g @openai/codex || failures=$((failures + 1))
fi
run_update "claude code" claude update || failures=$((failures + 1))

echo ""
if [[ "$failures" -eq 0 ]]; then
  echo "All update commands completed successfully."
else
  echo "Completed with ${failures} failed update(s)."
  exit 1
fi
