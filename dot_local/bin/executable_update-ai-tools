#!/usr/bin/env bash
set -u

run_update() {
  local tool_name="$1"
  shift

  echo ""
  echo "=== Updating ${tool_name} ==="

  if "$@"; then
    echo "✅ ${tool_name} updated"
    return 0
  else
    local status=$?
    echo "❌ ${tool_name} update failed (exit ${status})"
    return "$status"
  fi
}

# Remove npm copies first so the installer can claim ~/.local/bin/pi; ones
# under older mise node versions keep a dead pi shim ahead of ~/.local/bin.
# The installer prompts through /dev/tty, which piping cannot silence; a new
# session without a controlling terminal makes it use its defaults.
install_managed_pi() (
  set -o pipefail
  for node_bin in "$HOME"/.local/share/mise/installs/node/*/bin; do
    if [ -e "$node_bin/pi" ]; then
      env "PATH=$node_bin:$PATH" "$node_bin/npm" uninstall -g @earendil-works/pi-coding-agent || exit
    fi
  done
  if command -v mise >/dev/null 2>&1; then
    mise reshim
  fi
  npm --prefix "$HOME/.local" uninstall -g @earendil-works/pi-coding-agent &&
    curl -fsSL https://pi.dev/install.sh |
    env "PATH=$HOME/.local/bin:$PATH" perl -MPOSIX -e 'POSIX::setsid(); exec @ARGV' sh
)

failures=0

# Pi's installer pins dependencies; plain npm installs are migrated once.
if [ ! -f "${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}/install/managed-install.json" ]; then
  run_update "pi installer" install_managed_pi || failures=$((failures + 1))
fi
run_update "pi" env "PATH=$HOME/.local/bin:$PATH" pi update --all || failures=$((failures + 1))
run_update "codex" npm --prefix "$HOME/.local" install -g @openai/codex --include=optional || failures=$((failures + 1))
run_update "claude code" claude update || failures=$((failures + 1))

echo ""
if [[ "$failures" -eq 0 ]]; then
  echo "All update commands completed successfully."
else
  echo "Completed with ${failures} failed update(s)."
  exit 1
fi
