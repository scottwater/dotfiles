#!/usr/bin/env bash
# Runs a coding agent past the Orbie fleet gateway for one session, using the
# machine's own login, for when the gateway is down. Only a machine with its
# own login (the Macs) can use this; workers have none. The settings the
# dotfiles wrote are untouched: Claude Code takes a one-session settings
# override that clears the gateway URL and the key helper, Codex takes its
# built-in provider. Usage: ai-direct claude [args...] | ai-direct codex [args...]
set -euo pipefail

tool=${1:-}
[ -n "$tool" ] && shift || true
case "$tool" in
  claude) exec claude --settings '{"apiKeyHelper": "", "env": {"ANTHROPIC_BASE_URL": ""}}' "$@" ;;
  codex) exec codex -c 'model_provider="openai"' "$@" ;;
  *)
    echo "usage: ai-direct claude [args...] | ai-direct codex [args...]" >&2
    echo "Pi: pick a non-fleet provider with its /model command instead." >&2
    exit 2
    ;;
esac
