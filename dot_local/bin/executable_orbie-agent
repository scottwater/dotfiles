#!/usr/bin/env python3
"""The Orbie fleet agent. Standard library only; runs on macOS and Linux.

Every run reports this machine's metrics and tool versions to fleetd, then
runs whatever jobs fleetd queued from a fixed allowlist and posts their
results. A newly approved machine receives its gateway key in the report's
answer, writes proxy.env and applies the dotfiles, which point the tools at
the gateway. There is no agent token: fleetd identifies the caller by its
Tailscale address. See fleet/design.md in the orbie repository.

Usage: orbie-agent [--dry-run]   (--dry-run prints the report, sends nothing)
"""
from __future__ import annotations

import fcntl
import hashlib
import json
import os
import platform
import re
import shutil
import socket
import subprocess
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

HOME = Path.home()
PROXY_ENV = HOME / ".config/orbie/proxy.env"
DEFAULT_FLEET_URL = "https://orbie-fleet.ladon-justice.ts.net:9443"
TOOLS = ("claude", "codex", "pi", "grok", "muse", "t3", "mise")
# ~/.t3/bin holds the t3 command the T3 Code desktop app writes, which runs
# the app's bundled server, so on a desktop it reports the app's version.
EXTRA_PATH = (HOME / ".local/bin", HOME / ".local/share/mise/shims", HOME / ".local/share/orbi/agents/bin",
              HOME / ".t3/bin", Path("/opt/homebrew/bin"), Path("/usr/local/bin"))
SKILLS_SOURCE = "scottwater/skills"
SKILL_LOCK = HOME / ".agents/.skill-lock.json"
JOB_TIMEOUT = 30 * 60
VERSION_RE = re.compile(r"\d+(?:\.\d+)+(?:[-+.][0-9A-Za-z.]+)?")


def env_file(path: Path) -> dict[str, str]:
    values: dict[str, str] = {}
    if path.is_file():
        for line in path.read_text().splitlines():
            if "=" in line and not line.startswith("#"):
                key, value = line.split("=", 1)
                values[key.strip()] = value.strip()
    return values


def fleet_url() -> str:
    if os.environ.get("ORBIE_FLEET_URL"):
        return os.environ["ORBIE_FLEET_URL"].rstrip("/")
    gateway = env_file(PROXY_ENV).get("ORBIE_GATEWAY_URL", "").rstrip("/")
    return f"{gateway}:9443" if gateway else DEFAULT_FLEET_URL


def tool_path() -> str:
    return os.pathsep.join([str(p) for p in EXTRA_PATH] + [os.environ.get("PATH", "")])


def run(command: list[str], timeout: int = 20, path_prefix: tuple[Path, ...] = ()) -> subprocess.CompletedProcess[str]:
    path = os.pathsep.join([str(p) for p in path_prefix] + [tool_path()])
    # ORBIE_AGENT_JOB tells the dotfiles hooks they run under the agent, so
    # the macOS one does not reload the LaunchAgent that is running them.
    return subprocess.run(command, capture_output=True, text=True, timeout=timeout, check=False,
                          env={**os.environ, "PATH": path, "HOME": str(HOME), "ORBIE_AGENT_JOB": "1"})


def version_of(tool: str) -> str | None:
    """The tool's version, or None when it is not installed. A tool that is
    present but answers oddly reports "present"."""
    executable = shutil.which(tool, path=tool_path())
    if not executable:
        return None
    try:
        result = run([executable, "--version"])
    except (subprocess.SubprocessError, OSError):
        return "present"
    first = (result.stdout or result.stderr).strip().splitlines()
    match = VERSION_RE.search(first[0]) if first else None
    return match.group(0) if match else "present"


def versions() -> dict[str, str | None]:
    return {tool: version_of(tool) for tool in TOOLS}


# Metrics ----------------------------------------------------------------------

def cpu_percent_linux() -> float | None:
    def sample() -> tuple[int, int]:
        fields = Path("/proc/stat").read_text().splitlines()[0].split()[1:]
        values = [int(v) for v in fields]
        return values[3] + values[4], sum(values)  # idle+iowait, total
    try:
        idle1, total1 = sample()
        time.sleep(1)
        idle2, total2 = sample()
    except (OSError, ValueError, IndexError):
        return None
    total = total2 - total1
    return None if total <= 0 else round(100 * (1 - (idle2 - idle1) / total), 1)


def cpu_percent_macos() -> float | None:
    try:
        out = run(["ps", "-A", "-o", "%cpu="]).stdout
        busy = sum(float(v) for v in out.split())
        return round(min(100.0, busy / (os.cpu_count() or 1)), 1)
    except (subprocess.SubprocessError, OSError, ValueError):
        return None


def memory_percent() -> float | None:
    try:
        if sys.platform == "darwin":
            total = int(run(["sysctl", "-n", "hw.memsize"]).stdout.strip())
            page = 4096
            available = 0
            for line in run(["vm_stat"]).stdout.splitlines():
                if line.startswith("Mach Virtual Memory Statistics"):
                    size = re.search(r"page size of (\d+)", line)
                    page = int(size.group(1)) if size else page
                for label in ("Pages free", "Pages inactive", "Pages speculative"):
                    if line.startswith(label):
                        available += int(line.split(":")[1].strip().rstrip("."))
            return round(100 * (1 - available * page / total), 1)
        info = {}
        for line in Path("/proc/meminfo").read_text().splitlines():
            key, _, rest = line.partition(":")
            info[key] = int(rest.split()[0])
        return round(100 * (1 - info["MemAvailable"] / info["MemTotal"]), 1)
    except (subprocess.SubprocessError, OSError, ValueError, KeyError, ZeroDivisionError):
        return None


def uptime() -> str:
    try:
        if sys.platform == "darwin":
            boot = int(re.search(r"sec = (\d+)", run(["sysctl", "-n", "kern.boottime"]).stdout).group(1))  # type: ignore[union-attr]
            seconds = time.time() - boot
        else:
            seconds = float(Path("/proc/uptime").read_text().split()[0])
    except (subprocess.SubprocessError, OSError, ValueError, AttributeError):
        return ""
    days, rest = divmod(int(seconds), 86400)
    hours, rest = divmod(rest, 3600)
    return f"{days}d {hours}h" if days else f"{hours}h {rest // 60}m"


def os_name() -> str:
    try:
        if sys.platform == "darwin":
            return "macOS " + run(["sw_vers", "-productVersion"]).stdout.strip()
        for line in Path("/etc/os-release").read_text().splitlines():
            if line.startswith("PRETTY_NAME="):
                return line.split("=", 1)[1].strip().strip('"')
    except (subprocess.SubprocessError, OSError):
        pass
    return platform.platform()


def git_commit(path: Path) -> str:
    if not (path / ".git").exists():
        return ""
    try:
        return run(["git", "-C", str(path), "rev-parse", "--short", "HEAD"]).stdout.strip()
    except (subprocess.SubprocessError, OSError):
        return ""


def skills() -> dict[str, object]:
    """The shared skills as the skills CLI recorded them: a revision digest of
    each skill's folder hash in the source repository, how many there are,
    and when they were last synced. Empty when they were never synced."""
    try:
        entries = json.loads(SKILL_LOCK.read_text()).get("skills") or {}
    except (OSError, ValueError, AttributeError):
        return {}
    shared = sorted((name, entry) for name, entry in entries.items()
                    if isinstance(entry, dict) and entry.get("source") == SKILLS_SOURCE)
    if not shared:
        return {}
    digest = hashlib.sha256("".join(f"{name}:{entry.get('skillFolderHash', '')}\n" for name, entry in shared).encode())
    return {"revision": digest.hexdigest()[:12], "count": len(shared),
            "syncedAt": max(str(entry.get("updatedAt") or "") for _, entry in shared)}


def metrics() -> dict[str, object]:
    usage = shutil.disk_usage(HOME)
    load = os.getloadavg()[0] if hasattr(os, "getloadavg") else None
    return {
        "load1": None if load is None else round(load, 2),
        "cpuPercent": cpu_percent_macos() if sys.platform == "darwin" else cpu_percent_linux(),
        "memoryPercent": memory_percent(),
        "diskPercent": round(100 * usage.used / usage.total, 1),
        "diskFreeGb": round(usage.free / 1e9, 1),
        "cpus": os.cpu_count(),
    }


def report() -> dict[str, object]:
    key = env_file(PROXY_ENV).get("ORBIE_GATEWAY_KEY", "")
    return {
        "hostname": socket.gethostname().split(".")[0],
        "os": os_name(),
        "arch": platform.machine(),
        "uptime": uptime(),
        "metrics": metrics(),
        "versions": versions(),
        "dotfilesCommit": git_commit(HOME / ".local/share/chezmoi"),
        "skills": skills(),
        "keyFingerprint": hashlib.sha256(key.encode()).hexdigest()[:16] if key else "",
        "agentVersion": 2,
    }


# fleetd ------------------------------------------------------------------------

def post(url: str, body: dict[str, object]) -> dict[str, object]:
    request = urllib.request.Request(url, data=json.dumps(body).encode(), method="POST",
                                     headers={"Content-Type": "application/json", "User-Agent": "orbie-agent/1"})
    with urllib.request.urlopen(request, timeout=30) as response:
        return json.loads(response.read() or b"{}")


def write_proxy_env(gateway_url: str, key: str, machine: str) -> None:
    PROXY_ENV.parent.mkdir(parents=True, exist_ok=True)
    temporary = PROXY_ENV.with_suffix(".tmp")
    with open(temporary, "w", opener=lambda p, f: os.open(p, f, 0o600)) as handle:
        handle.write(f"ORBIE_GATEWAY_URL={gateway_url}\nORBIE_GATEWAY_KEY={key}\nORBIE_MACHINE={machine}\n")
    os.chmod(temporary, 0o600)
    temporary.replace(PROXY_ENV)


# Jobs -------------------------------------------------------------------------

TOOLING_NODE = HOME / ".local/share/orbi/tooling-node/bin"


def skills_command() -> list[str]:
    tooling = TOOLING_NODE / "npx"
    npx = [str(tooling)] if tooling.exists() else ["npx"]
    return npx + ["--yes", "skills@latest", "add", SKILLS_SOURCE, "--global", "--skill", "*",
                  "--agent", "universal", "claude-code", "--yes"]


def job_command(kind: str) -> list[str] | None:
    return {
        # --force as in orbie's setup: mise rewrites its config, and there is
        # no terminal to answer chezmoi's overwrite prompt.
        "apply-dotfiles": ["chezmoi", "update", "--force"],
        "update-agents": ["update-ai-tools"],
        "sync-skills": skills_command(),
    }.get(kind)


def rotate_key(args: dict[str, object]) -> tuple[int, str]:
    """Switches to the key fleetd handed over, after checking that the gateway
    accepts it. fleetd removes the old key only on a zero exit, so a refused
    key leaves this machine as it was."""
    key, url, machine = str(args.get("key") or ""), str(args.get("gatewayUrl") or "").rstrip("/"), str(args.get("machine") or "")
    if not key or not url:
        return 2, "rotate-key: the job carried no key\n"
    request = urllib.request.Request(f"{url}/v1/models", headers={"Authorization": f"Bearer {key}", "User-Agent": "orbie-agent/1"})
    try:
        with urllib.request.urlopen(request, timeout=30) as response:
            if response.status != 200:
                return 1, f"rotate-key: the gateway answered {response.status} to the new key\n"
    except (urllib.error.URLError, OSError) as error:
        return 1, f"rotate-key: the gateway refused the new key: {error}\n"
    write_proxy_env(url, key, machine or socket.gethostname().split(".")[0])
    return 0, f"switched to key {hashlib.sha256(key.encode()).hexdigest()[:16]}\n"


def configure_gateway(apply_dotfiles: bool) -> tuple[int, str]:
    """Points the tools at the gateway after the key arrives. Machines that
    take the shared dotfiles apply them, which runs the configure hook; a
    machine that keeps its own dotfiles (fleetd says dotfiles=false, or there
    is no chezmoi) runs orbie-configure-gateway, the same script installed
    by hand."""
    if apply_dotfiles and shutil.which("chezmoi", path=tool_path()):
        return run_job("apply-dotfiles")
    script = shutil.which("orbie-configure-gateway", path=tool_path())
    if not script:
        return 127, "neither chezmoi nor orbie-configure-gateway is installed; the tools are not configured\n"
    try:
        result = run([script], timeout=120)
    except (subprocess.SubprocessError, OSError) as error:
        return 1, f"orbie-configure-gateway: {error}\n"
    return result.returncode, (result.stdout or "") + (result.stderr or "")


def run_job(kind: str, args: dict[str, object] | None = None) -> tuple[int, str]:
    if kind == "rotate-key":
        return rotate_key(args or {})
    command = job_command(kind)
    if command is None:
        return 2, f"{kind} is not implemented by this agent\n"
    # The tooling npx is a script that runs whatever node is first on PATH. On
    # a machine whose mise sets no global node that is an empty shim, so the
    # tooling's own node goes first.
    prefix = (TOOLING_NODE,) if kind == "sync-skills" and TOOLING_NODE.exists() else ()
    try:
        result = run(command, timeout=JOB_TIMEOUT, path_prefix=prefix)
    except subprocess.TimeoutExpired:
        return 124, f"{kind} timed out after {JOB_TIMEOUT // 60} minutes\n"
    except OSError as error:
        return 127, f"{kind}: {error}\n"
    output = (result.stdout or "") + (("\n" + result.stderr) if result.stderr else "")
    return result.returncode, output[-4000:]


def main(argv: list[str]) -> int:
    dry_run = "--dry-run" in argv
    body = report()
    if dry_run:
        print(json.dumps(body, indent=2))
        return 0
    lock_path = HOME / ".cache/orbie/agent.lock"
    lock_path.parent.mkdir(parents=True, exist_ok=True)
    with open(lock_path, "w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            print("another agent run is in progress", file=sys.stderr)
            return 0
        base = fleet_url()
        try:
            answer = post(f"{base}/api/report", body)
        except (urllib.error.URLError, OSError, ValueError) as error:
            print(f"fleetd at {base} unreachable: {error}", file=sys.stderr)
            return 1
        if answer.get("key"):
            write_proxy_env(str(answer.get("gatewayUrl") or ""), str(answer["key"]), str(answer.get("machine") or body["hostname"]))
            code, output = configure_gateway(bool(answer.get("dotfiles", True)))
            print(f"gateway key received; tools configured with exit {code}" + (f": {output.strip()[-300:]}" if code else ""),
                  file=sys.stderr if code else sys.stdout)
        for job in answer.get("jobs") or []:
            args = job.get("args") if isinstance(job.get("args"), dict) else {}
            code, output = run_job(str(job.get("kind")), args)
            try:
                post(f"{base}/api/jobs/{int(job['id'])}/result", {"exitCode": code, "output": output})
            except (urllib.error.URLError, OSError, ValueError) as error:
                print(f"could not post the result of job {job.get('id')}: {error}", file=sys.stderr)
        print(f"reported to {base}: {answer.get('status')}, {len(answer.get('jobs') or [])} job(s)")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
