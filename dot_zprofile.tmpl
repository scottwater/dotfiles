{{- $role := get . "role" | default "workstation" -}}
export PATH="$HOME/.local/bin:$PATH"

{{ if eq .chezmoi.os "darwin" -}}
if [ -x /opt/homebrew/bin/brew ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
  export PATH="/opt/homebrew/opt/libpq/bin:$PATH"
fi
{{- end }}

export XDG_CONFIG_HOME="$HOME/.config"
{{- if eq $role "bb-worker" }}
export RAILS_EDITOR="nvim"
{{- else }}
export RAILS_EDITOR="zed"
{{- end }}

if command -v mise >/dev/null 2>&1; then
  # Non-interactive login shells (Codex) skip .zshrc; ensure shims exist there.
  if ! [[ -o interactive ]] && [[ ":$PATH:" != *":$HOME/.local/share/mise/shims:"* ]]; then
    eval "$(mise activate zsh --shims)"
  fi
fi

{{- if eq .chezmoi.os "darwin" }}
source ~/.orbstack/shell/init.zsh 2>/dev/null || :
{{- end }}
