{{- /* chezmoi:modify-template */ -}}
{{- /* Some fields belong to whatever last wrote them on this machine, so this
       modify template keeps their values from the file on disk
       (.chezmoi.stdin) and they never show in a diff: lastChangelogVersion,
       which Pi bumps after every update, and defaultProvider and
       enabledModels, which the Orbie fleet client sets on machines enrolled
       with its gateway. The values below are for a machine with neither.
       Pi only ever writes valid JSON there. */ -}}
{{- $version := "1.3.0" -}}
{{- $provider := "openai-codex" -}}
{{- $models := list
      "openai-codex/gpt-6-luna" "openai-codex/gpt-6.1-sol" "openai-codex/gpt-6-astra"
      "opencode-go/minimax-m3" "opencode-go/qwen3.8-flash" "opencode-go/deepseek-v4-flash"
      "opencode-go/deepseek-v4.1-flash" "opencode-go/glm-5.3" "opencode-go/glm-5.3-flash"
      "opencode-go/kimi-k3" "opencode-go/grok-4.7" "opencode-go/muse-spark-1.2-contributor"
      "opencode-go/muse-spark-1.3-contributor" "xai/grok-4.7" -}}
{{- if .chezmoi.stdin -}}
{{-   $current := fromJson .chezmoi.stdin -}}
{{-   if hasKey $current "lastChangelogVersion" -}}{{- $version = $current.lastChangelogVersion -}}{{- end -}}
{{-   if hasKey $current "defaultProvider" -}}{{- $provider = $current.defaultProvider -}}{{- end -}}
{{-   if hasKey $current "enabledModels" -}}{{- $models = $current.enabledModels -}}{{- end -}}
{{- end -}}
{
  "lastChangelogVersion": {{ $version | quote }},
  "defaultProvider": {{ $provider | quote }},
  "defaultModel": "gpt-6-astra",
  "defaultThinkingLevel": "medium",
  "quietStartup": true,
  "skills": [
    "!/Users/scott/.pi/agent/skills/**"
  ],
  "packages": [
    "git:github.com/scottwater/pi-stoic",
    "npm:@tintinweb/pi-subagents"
  ],
  "theme": "Tokyo Night",
  "enabledModels": {{ $models | toPrettyJson | trim | replace "\n" "\n  " }},
  "pi-codex-fast": {
    "enabled": false
  },
  "powerline": "default",
  "workingVibe": "zen",
  "transport": "auto",
  "tuiMode": "regular",
  "steeringMode": "all"
}
