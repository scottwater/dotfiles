{{- /* chezmoi:modify-template */ -}}
{{- /* Machines enrolled with the fleet gateway (proxy.env present) use its
       providers from models.json, written by run_after_configure-fleet-gateway.sh.
       Pi matches enabledModels with minimatch, where "*" stops at a slash, so
       the fleet provider's "go/..." ids need "**".
       Pi bumps lastChangelogVersion after every update, so this modify template
       keeps the value from the file on disk (.chezmoi.stdin) and the field never
       shows in a diff. Pi only ever writes valid JSON there. */ -}}
{{- $fleet := stat (joinPath .chezmoi.homeDir ".config/orbie/proxy.env") -}}
{{- $version := "1.3.0" -}}
{{- if .chezmoi.stdin -}}
{{-   $current := fromJson .chezmoi.stdin -}}
{{-   if hasKey $current "lastChangelogVersion" -}}{{- $version = $current.lastChangelogVersion -}}{{- end -}}
{{- end -}}
{
  "lastChangelogVersion": {{ $version | quote }},
  "defaultProvider": {{ if $fleet }}"fleet-codex"{{ else }}"openai-codex"{{ end }},
  "defaultModel": "gpt-6-astra",
  "defaultThinkingLevel": "medium",
  "quietStartup": true,
  "skills": [
    "!/Users/scott/.pi/agent/skills/**"
  ],
  "packages": [
    "git:github.com/scottwater/pi-stoic",
    "npm:@tintinweb/pi-subagents"
  ],
  "theme": "Tokyo Night",
  "enabledModels": [
{{- if $fleet }}
    "fleet-codex/*",
    "fleet/**"
{{- else }}
    "openai-codex/gpt-6-luna",
    "openai-codex/gpt-6.1-sol",
    "openai-codex/gpt-6-astra",
    "opencode-go/minimax-m3",
    "opencode-go/qwen3.8-flash",
    "opencode-go/deepseek-v4-flash",
    "opencode-go/deepseek-v4.1-flash",
    "opencode-go/glm-5.3",
    "opencode-go/glm-5.3-flash",
    "opencode-go/kimi-k3",
    "opencode-go/grok-4.7",
    "opencode-go/muse-spark-1.2-contributor",
    "opencode-go/muse-spark-1.3-contributor",
    "xai/grok-4.7"
{{- end }}
  ],
  "pi-codex-fast": {
    "enabled": false
  },
  "powerline": "default",
  "workingVibe": "zen",
  "transport": "auto",
  "tuiMode": "regular",
  "steeringMode": "all"
}
