{{- /* Machines enrolled with the fleet gateway (proxy.env present) use its
       providers from models.json, written by run_after_configure-fleet-gateway.sh. */ -}}
{{- $fleet := stat (joinPath .chezmoi.homeDir ".config/orbie/proxy.env") -}}
{
  "lastChangelogVersion": "1.0.2",
  "defaultProvider": {{ if $fleet }}"fleet-codex"{{ else }}"openai-codex"{{ end }},
  "defaultModel": "gpt-6-astra",
  "defaultThinkingLevel": "medium",
  "quietStartup": true,
  "skills": [
    "!/Users/scott/.pi/agent/skills/**"
  ],
  "packages": [
    "https://github.com/nicobailon/visual-explainer",
    "https://github.com/calesennett/pi-codex-fast",
    "npm:glimpseui",
    "git:github.com/dbachelder/pi-btw",
    "git:github.com/scottwater/pi-stoic",
    "npm:sideshow",
    "npm:@plannotator/pi-extension",
    "npm:@tintinweb/pi-subagents"
  ],
  "theme": "Tokyo Night",
  "enabledModels": [
{{- if $fleet }}
    "fleet-codex/*",
    "fleet-claude/*",
    "fleet/*"
{{- else }}
    "openai-codex/gpt-6-luna",
    "openai-codex/gpt-6.1-sol",
    "openai-codex/gpt-6-astra",
    "opencode-go/minimax-m3",
    "opencode-go/qwen3.8-flash",
    "opencode-go/deepseek-v4-flash",
    "opencode-go/deepseek-v4.1-flash",
    "opencode-go/glm-5.3",
    "opencode-go/glm-5.3-flash",
    "opencode-go/kimi-k3",
    "opencode-go/grok-4.7",
    "opencode-go/muse-spark-1.2-contributor",
    "opencode-go/muse-spark-1.3-contributor",
    "xai/grok-4.7"
{{- end }}
  ],
  "pi-codex-fast": {
    "enabled": false
  },
  "powerline": "default",
  "workingVibe": "zen",
  "transport": "auto",
  "tuiMode": "regular",
  "steeringMode": "all"
}
